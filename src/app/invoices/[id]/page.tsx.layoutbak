"use client";

import { useEffect, useState } from "react";

export default function InvoiceDetails({
  params,
}: {
  params: Promise<{ id: string }>;
}) {
  const [invoice, setInvoice] = useState<any>(null);

  useEffect(() => {
    (async () => {
      const { id } = await params;
      const res = await fetch(`/api/invoices/${id}`);
      const data = await res.json();
      setInvoice(data);
    })();
  }, [params]);

  if (!invoice) {
    return <main className="p-6">Loading invoice...</main>;
  }

  return (
    <main className="max-w-4xl mx-auto p-6 space-y-6">
      <h1 className="text-3xl font-bold">
        {invoice.invoiceNumber}
      </h1>

      <div className="rounded-xl border p-6 space-y-3">
        <p><strong>Status:</strong> {invoice.status}</p>
        <p><strong>Subtotal:</strong> R{Number(invoice.subtotal).toFixed(2)}</p>
        <p><strong>VAT:</strong> R{Number(invoice.tax).toFixed(2)}</p>
        <p><strong>Discount:</strong> R{Number(invoice.discount).toFixed(2)}</p>
        <p className="text-xl font-bold">
          Total: R{Number(invoice.total).toFixed(2)}
        </p>
      </div>
    </main>
  );
}
